{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "bingo: Debug active Go package",
      "type": "bingo",
      "request": "launch",
      "mode": "debug"
    },
    {
      "name": "bingo: Join running session",
      "type": "bingo",
      "request": "attach",
      "session": "${input:bingoSession}"
    }
  ],
  "inputs": [
    {
      "id": "bingoSession",
      "type": "promptString",
      "description": "bingo session ID to join (from the server's console line or /api/sessions)"
    }
  ]
}
