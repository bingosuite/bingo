{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "bingo: Debug example",
      "type": "bingo",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/examples/${input:bingoExample}"
    },
    {
      "name": "bingo: Debug spawntree telemetry demo",
      "type": "bingo",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/examples/spawntree"
    },
    {
      "name": "bingo: Join running session",
      "type": "bingo",
      "request": "attach",
      "session": "${input:bingoSession}"
    }
  ],
  "inputs": [
    {
      "id": "bingoExample",
      "type": "pickString",
      "description": "Progressive debugger example",
      "options": [
        "level1-loop",
        "level2-channel",
        "level3-worker-pool",
        "level4-pipeline",
        "level5-workflow"
      ],
      "default": "level1-loop"
    },
    {
      "id": "bingoSession",
      "type": "promptString",
      "description": "bingo session ID to join (from the server's console line or /api/sessions)"
    }
  ]
}
